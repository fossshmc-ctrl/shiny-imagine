# V29 Windows 本地版和 Vercel 线上版共用的环境变量模板。
# 不要把真实令牌写入此文件、压缩包或 Git；请在 Vercel Project Settings → Environment Variables 中填写。
AI_LINKUANG_ACCESS_CODE=
EVOLINK_API_KEY=
EVOLINK_BASE_URL=https://api.evolink.ai/v1
COZE_API_TOKEN=
PADDLEOCR_ACCESS_TOKEN=

# 可选：逗号分隔的自定义 API 主机名。线上默认仅允许 api.evolink.ai / direct.evolink.ai。
AI_LINKUANG_ALLOWED_API_HOSTS=
